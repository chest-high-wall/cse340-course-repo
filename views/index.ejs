
<%- include('partials/header') %>

<main>
    <h1>Welcome to the CSE 340 Service Network!</h1>

    <p>
        Our mission is to promote service across the world
        by connecting volunteers with service opportunities
        in their community.
    </p>

    <section>
        <h2>Make a Difference</h2>

        <p>
            Explore organizations, discover service projects,
            and find opportunities to help your community.
        </p>

        <img
            class="main-logo"
            src="/images/cse340-service-network.png"
            alt="CSE 340 Service Network Logo"
        >
    </section>

    <section>
        <h2>Get Involved</h2>

        <p>
            Whether you want to volunteer your time, support
            local organizations, or participate in community
            projects, Service Network helps you find ways
            to make a positive impact.
        </p>

        <img
            src="/images/volunteers.jpg"
            alt="Volunteers working together on a community project"
            style="max-width: 100%; height: auto;"
        >
    </section>
</main>

<%- include('partials/footer') %>
