
<%- include('partials/header') %>

<main>
    <h1>Service Projects</h1>

    <p>
        Discover opportunities to make a difference
        in your community.
    </p>

    <section>
        <h2>Upcoming Service Projects</h2>

        <p>
            Explore the next five upcoming service projects
            and find ways to volunteer.
        </p>

        <% if (projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p><%= project.description %></p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Date:</strong>
                            <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC' }) %>
                        </p>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No upcoming service projects are currently available.</p>
        <% } %>
    </section>

    <section>
        <h2>Get Involved</h2>

        <p>
            Every act of service makes a difference.
            Find a project that matches your interests
            and start helping your community today!
        </p>
    </section>
</main>

<%- include('partials/footer') %>
