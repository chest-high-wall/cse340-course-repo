
<%- include('partials/header') %>

<main>
    <h1><%= categoryDetails.name %></h1>

    <section>
        <h2>Service Projects in This Category</h2>

        <% if (projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p><%= project.description %></p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Date:</strong>
                            <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC' }) %>
                        </p>

                        <p>
                            <strong>Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No service projects are currently assigned to this category.</p>
        <% } %>
    </section>

    <p>
        <a href="/categories">Back to Categories</a>
    </p>
</main>

<%- include('partials/footer') %>
